# Konfiguration des Lock-Mockups. Kopiere diese Datei nach `.env`
# (`cp .env.example .env`) und passe sie an. `npm start` laedt `.env`
# automatisch (Node `--env-file-if-exists`).

# --- Netzwerk ---
# Nicht-Standard-HTTP-Port (nicht 80/443), damit die Recon-Uebung Sinn ergibt.
# Tipp: ein Port ausserhalb der Nmap-Top-1000 (z. B. 8123) erhoeht die
# Schwierigkeit, weil dann ein voller Portscan noetig ist.
LOCK_PORT=8080
# 0.0.0.0 = im IoTNet erreichbar. Zum lokalen Testen ggf. 127.0.0.1.
LOCK_HOST=0.0.0.0

# --- Zugangsdaten (bewusst schwach: das ist die Lektion) ---
LOCK_USER=admin
LOCK_PASSWORD=admin
# Signatur-Secret des Session-Cookies. Im Lab-Betrieb unbedingt setzen.
LOCK_SESSION_SECRET=change-me-insecure-lab-secret

# --- Geraete-Identitaet (Server-Header / Titel / /api/status) ---
LOCK_DEVICE_NAME=SmartLock-IoT
LOCK_FIRMWARE=1.2.0

# Hinweis auf die Standard-Zugangsdaten als HTML-Kommentar im Quelltext der
# Login-Seite anzeigen (belohnt "View Source"). true|false
LOCK_HINT=true

# Startzustand: locked|unlocked
LOCK_START_STATE=locked

# --- Unlock-Hook (optional) ---
# Beim Entriegeln wird — falls gesetzt — dieser Webhook per POST aufgerufen
# und/oder dieses Shell-Kommando ausgefuehrt. Standardmaessig leer: reines
# visuelles Mockup. Damit laesst sich spaeter ein echtes Relais ansteuern.
# UNLOCK_HOOK_URL=http://relay.local/unlock
# ACHTUNG: fuehrt ein Shell-Kommando aus. Nur von der Lehrperson setzen.
# UNLOCK_HOOK_CMD=gpioset gpiochip0 17=1
